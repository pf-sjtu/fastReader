# 前端

# 共享密码：缺省 123456a。正式环境必须在 Cloudflare Pages 的
# Settings → Variables and Secrets 里配置，不要提交到仓库。
# APP_PASSWORD=123456a

# 可选：会话签名密钥（留空则派生自 APP_PASSWORD）
# SESSION_SECRET=

# 可选：额外 CORS 白名单，逗号分隔
# ALLOWED_ORIGINS=https://your-domain.pages.dev

# 本地开发（wrangler pages dev --kv FASTREADER_KV --binding APP_PASSWORD=123456a）
# 不需要 .env：绑定通过命令行参数传入

# 本地模型（Ollama）直连，浏览器访问，不经服务端代理
# VITE_OLLAMA_BASE_URL=http://localhost:11434

# 真实联调测试（可选）：设置后才运行 tests/tour 下的 live 用例
# E2E_CONFIG=<path to a yaml with real credentials>

# v2/v3 提示词真实模型评测（tests/tour/eval_prompts.py；OpenAI 兼容网关，只读，不打印）
# VITE_TEST_LLM_BASE_URL=https://example.com/v1
# VITE_TEST_LLM_API_KEY=
# VITE_TEST_LLM_MODEL=

# ===== CLI（src/cli）=====
# CLI 读取 YAML 配置，支持 ${VAR} 环境变量替换；2.0.0 导出默认把密钥写成占位符
# FASTREADER_PROVIDER_<NAME>_KEY=sk-...
# FASTREADER_WEBDAV_PASSWORD=...
# FASTREADER_WEBDAV_USERNAME=...
# 可选：与浏览器共用「模型参数怪癖」存档（服务商真实输出上限 / 参数名 / 不支持温度等，验证成功才写入）
# FASTREADER_SERVER_URL=https://fast-read.pages.dev
# FASTREADER_APP_PASSWORD=...
