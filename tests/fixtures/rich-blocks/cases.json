      "prose": "正文\n\n尾"
    },
    {
      "name": "更长的围栏：内部出现 ``` 不会提前结束",
      "input": "前\n\n````html\n<pre>```\ncode\n```</pre>\n````\n\n后",
      "prose": "前\n\n后"
    },
    {
      "name": "未闭合（被截断）：到文末都算块",
      "input": "正文。\n\n```mermaid\ngraph LR\n  A --> B\n  B --> ",
      "prose": "正文。\n\n"
    }
  ],
  "list": [
    {
      "name": "闭合 + 未闭合尾块",
      "input": "前\n\n```mermaid\ngraph LR\nA-->B\n```\n\n中\n\n```genui\n{\"type\":",
      "blocks": [
        { "lang": "mermaid", "code": "graph LR\nA-->B", "truncated": false },
        { "lang": "genui", "code": "{\"type\":", "truncated": true }
      ]
    },
    {
      "name": "空块与大小写",
      "input": "```HTML\n\n```",
      "blocks": [{ "lang": "html", "code": "", "truncated": false }]
    },
    {
      "name": "没有块",
      "input": "只有正文",
      "blocks": []
    }
  ],
  "genui": [
    {
      "name": "七种组件各自可解析",
      "code": "[{\"type\":\"steps\",\"items\":[{\"label\":\"孕育\"},\"婴儿\"]},{\"type\":\"compare\",\"columns\":[\"A\",\"B\"],\"rows\":[{\"label\":\"风险\",\"cells\":[\"高\",\"低\"]}]},{\"type\":\"timeline\",\"items\":[{\"time\":\"1990\",\"label\":\"创立\"}]},{\"type\":\"cards\",\"items\":[{\"title\":\"甲\",\"body\":\"乙\"}]},{\"type\":\"callout\",\"tone\":\"warn\",\"body\":\"注意\"},{\"type\":\"tabs\",\"tabs\":[{\"label\":\"一\",\"body\":\"内容\"}]},{\"type\":\"quiz\",\"question\":\"谁？\",\"options\":[\"甲\",\"乙\"],\"answer\":1}]",
      "ok": true,
      "types": ["steps", "compare", "timeline", "cards", "callout", "tabs", "quiz"]
    },
    { "name": "单个节点", "code": "{\"type\":\"callout\",\"body\":\"x\"}", "ok": true, "types": ["callout"] },
    { "name": "{blocks:[…]} 写法", "code": "{\"blocks\":[{\"type\":\"callout\",\"body\":\"x\"}]}", "ok": true, "types": ["callout"] },
    { "name": "尾逗号 + 行注释宽容", "code": "// 说明\n{\"type\":\"steps\",\"items\":[{\"label\":\"甲\"},{\"label\":\"乙\"},]}", "ok": true, "types": ["steps"] },
    { "name": "坏节点丢弃，其余保留", "code": "[{\"type\":\"nope\"},{\"type\":\"callout\",\"body\":\"好\"},{\"type\":\"steps\",\"items\":[]}]", "ok": true, "types": ["callout"] },
