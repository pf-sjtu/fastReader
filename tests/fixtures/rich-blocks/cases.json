    { "name": "测验：选项不足 2 个", "code": "{\"type\":\"quiz\",\"question\":\"q\",\"options\":[\"a\"],\"answer\":0}", "ok": false, "error": "没有可渲染的组件" },
    { "name": "测验：答案是数字字符串", "code": "{\"type\":\"quiz\",\"question\":\"q\",\"options\":[\"a\",\"b\"],\"answer\":\"0\"}", "ok": true, "types": ["quiz"] },
    { "name": "测验：答案为 null 不是第 0 项", "code": "{\"type\":\"quiz\",\"question\":\"q\",\"options\":[\"a\",\"b\"],\"answer\":null}", "ok": false, "error": "没有可渲染的组件" },
    { "name": "测验：答案为小数", "code": "{\"type\":\"quiz\",\"question\":\"q\",\"options\":[\"a\",\"b\"],\"answer\":1.5}", "ok": false, "error": "没有可渲染的组件" },
    { "name": "对比表：没有列", "code": "{\"type\":\"compare\",\"columns\":[],\"rows\":[{\"label\":\"r\",\"cells\":[]}]}", "ok": false, "error": "没有可渲染的组件" },
    { "name": "type 大小写不敏感", "code": "{\"type\":\"CALLOUT\",\"body\":\"x\"}", "ok": true, "types": ["callout"] },
