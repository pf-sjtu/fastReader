#!/bin/sh
# 提交前自动 bump 构建号 YYYYMMDD.bN，并纳入本次提交
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] node not found; skip build version bump" >&2
  exit 0
fi

node scripts/bump-build.mjs || {
  echo "[pre-commit] bump-build failed" >&2
  exit 1
}

git add src/buildInfo.ts
