# Cloudflare Pages 响应头（构建时随 public/ 复制到 dist/）
# connect-src 不收窄到具体主机：AI 服务商由用户自定义，且需直连本机 Ollama
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# 总结里 html 块的沙箱页（放在目录里、URL 以 / 结尾：Pages 会把 /x.html 308 到 /x，而下面的规则匹配不到 /x）：单独的 CSP（摘掉全站那条）——允许内联脚本与样式，但没有任何网络（default-src 'none'）、
# 不能嵌套页面，且只允许同源页面把它嵌进 iframe。父页面的 script-src 'self' 会被 srcdoc / 本地文档继承而拦掉内联脚本，
# 所以 html 块必须走这个独立页面（tests/richSandbox.test.ts 守卫这条规则）
/rich-sandbox/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; sandbox allow-scripts
